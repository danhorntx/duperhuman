{
  "name": "superhuman-clone",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "npm run start --workspace=server",

    "electron:dev": "concurrently --names \"server,client,electron\" --prefix-colors \"cyan,green,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\" \"wait-on http://localhost:3000 && NODE_ENV=development electron .\"",

    "electron:bundle-server": "node scripts/bundle-server.mjs",

    "electron:dmg-assets": "node scripts/ensure-dmg-assets.mjs",

    "electron:build": "npm run build --workspace=client && npm run electron:bundle-server && electron-builder",

    "electron:build:mac": "npm run build --workspace=client && npm run electron:bundle-server && npm run electron:dmg-assets && electron-builder --mac",
    "electron:build:win": "npm run build --workspace=client && npm run electron:bundle-server && electron-builder --win",
    "electron:build:linux": "npm run build --workspace=client && npm run electron:bundle-server && electron-builder --linux"
  },
  "build": {
    "appId": "com.duperhuman.email",
    "productName": "Duperhuman",
    "copyright": "Copyright © 2025",
    "directories": {
      "output": "dist-app",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "!**/*.map",
      "!**/node_modules"
    ],
    "extraResources": [
      {
        "from": "dist-electron/server.mjs",
        "to": "server.mjs"
      }
    ],
    "dmg": {
      "title": "${productName} ${version}",
      "background": "build-resources/dmg-background.png",
      "window": {
        "x":      100,
        "y":      100,
        "width":  660,
        "height": 400
      },
      "iconSize":     100,
      "iconTextSize": 12,
      "contents": [
        { "x": 180, "y": 180, "type": "file" },
        { "x": 480, "y": 180, "type": "link", "path": "/Applications" }
      ],
      "format":          "ULFO",
      "internetEnabled": false,
      "writeUpdateInfo": false
    },
    "mac": {
      "icon": "build-resources/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0"
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "wait-on": "^7.2.0"
  }
}
