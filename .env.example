# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace_me_with_a_random_32byte_hex_string
# Keep false unless you are testing against a self-signed local mail server.
ALLOW_INSECURE_MAIL_TLS=false

# Gmail API / OAuth. Create these in Google Cloud Console and enable Gmail API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/google/callback

# ─── IMAP Account (set via UI on first run, or pre-seed here) ────────────────
# These map to the first account. Additional accounts are added through the UI.
# When Google OAuth is configured, this IMAP seed is disabled unless explicitly enabled.
ENABLE_DEFAULT_IMAP_ACCOUNT=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=you@gmail.com
IMAP_PASS=your_app_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_NAME=Your Name

# ─── Sync settings ────────────────────────────────────────────────────────────
SYNC_INTERVAL_MS=30000
INITIAL_SYNC_LIMIT=200

# ─── Client dev proxy ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
